<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.HomePage" 
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization">
    <Shell.TitleView>
        <Grid>
            <Label
                Text="{x:Static localization:AppResources.CowAndBulls}"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    
    <VerticalStackLayout Spacing="20">
        <Label 
            Text="{x:Static localization:AppResources.Welcome}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image Source="home.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20" >
            <Button 
                Text="{x:Static localization:AppResources.StartGame}" 
                Clicked="OnStartGameClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Fill" />
            <Button 
                Text="{x:Static localization:AppResources.Settings}" 
                Clicked="OnSettingsClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Fill" />
            <Button 
                Text="{x:Static localization:AppResources.Records}" 
                Clicked="OnRecordsClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Fill" />
            <Button 
                Text="{x:Static localization:AppResources.Rules}" 
                Clicked="OnHelpClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>