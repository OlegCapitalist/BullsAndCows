<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.HomePage"
             Title="Быки и Коровы">
    <VerticalStackLayout Spacing="20">
        <Label 
            Text="Добро пожаловать в игру Bulls and Cows!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image Source="home.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <VerticalStackLayout IsVisible="{Binding IsMenuVisible}" 
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20" >
            <Button 
                Text="Начать игру" 
                Clicked="OnStartGameClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Button 
                Text="⚙Настройки" 
                Clicked="OnSettingsClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Button 
                Text="Рекорды" 
                Clicked="OnRecordsClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Button 
                Text="Правила" 
                Clicked="OnHelpClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding IsLoadingVisible}" 
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing ="20" >
            <ActivityIndicator
                IsRunning="True"
                WidthRequest="48"
                HeightRequest="48" />
            <Label
                Text="Загрузка..."
                FontSize="18"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>