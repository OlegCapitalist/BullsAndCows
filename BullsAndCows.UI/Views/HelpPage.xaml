<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.HelpPage" 
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization">
    <Shell.TitleView>
        <Grid>
            <Label
            Text="{x:Static localization:AppResources.Rules}"
            FontSize="30"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    <VerticalStackLayout>
        <Image Source="help.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Label 
            Text="Игра из себя представляет головоломку"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button 
            Text="{x:Static localization:AppResources.Back}"
            Clicked="OnBackClicked"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>