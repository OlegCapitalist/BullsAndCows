<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.HelpPage"
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization">

    <Shell.TitleView>
        <Grid>
            <Label
                Text="{x:Static localization:AppResources.Rules}"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*,Auto">

        <Image
            Grid.Row="0"
            Source="help.png"
            Aspect="AspectFit"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <ScrollView
            Grid.Row="1"
            IsVisible="{Binding IsHelpTextVisible}">

            <Label
                Text="{Binding HelpText}"
                Margin="20,10"
                VerticalOptions="Start"
                HorizontalOptions="Fill" />

        </ScrollView>

        <Label
            Grid.Row="1"
            Text="{x:Static localization:AppResources.HelpTextNotLoaded}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoadingErrorVisible}" />

        <Button
            Grid.Row="2"
            Text="{x:Static localization:AppResources.Back}"
            Clicked="OnBackClicked"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Margin="10" />

    </Grid>

</ContentPage>