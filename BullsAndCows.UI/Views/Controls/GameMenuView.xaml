<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.Controls.GameMenuView"
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization" >

    <Grid ColumnDefinitions="*, *, *"
          ColumnSpacing="10" >
        
        <Button Grid.Column="0"
                Text="{x:Static localization:AppResources.NewGame}"
                HorizontalOptions="Fill" 
                Clicked="OnNewGameClicked" />
        <Button Grid.Column="1"
                Text="{x:Static localization:AppResources.Exit}"
                HorizontalOptions="Fill" 
                Clicked="OnExitClicked" />
        <Button Grid.Column="2"
                Text="{x:Static localization:AppResources.Rules}"
                HorizontalOptions="Fill" 
                Clicked="OnHelpClicked" />
    </Grid>

</ContentView>
