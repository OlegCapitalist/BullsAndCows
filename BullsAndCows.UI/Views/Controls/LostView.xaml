<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.Controls.LostView">
    <VerticalStackLayout IsVisible="{Binding IsLost}">
        <Label 
            Text="ИГРА ОКОНЧЕНА"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
            Text="Загаданный код был:"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
            Text="{Binding SecretCode}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image Source="lost.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </VerticalStackLayout>
</ContentView>
