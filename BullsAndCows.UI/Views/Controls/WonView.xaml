<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.Controls.WonView"
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization">
    <VerticalStackLayout IsVisible="{Binding IsWon}">
        <Label 
            Text="{x:Static localization:AppResources.Congratulations}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            Text="{Binding AttemptsCount, StringFormat={x:Static localization:AppResources.AttemptsUsed}}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Image Source="won.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Button Text="{x:Static localization:AppResources.Records}" 
                Clicked="OnRecordsClicked"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Margin="0,10" />
    </VerticalStackLayout>
</ContentView>
