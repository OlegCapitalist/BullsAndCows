<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:BullsAndCows.UI.Behaviors"
             x:Class="BullsAndCows.UI.Views.SettingsPage" 
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization" >
    <Shell.TitleView>
        <Grid>
            <Label
            Text="{x:Static localization:AppResources.Settings}"
            FontSize="30"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    <Grid>
        
        
        <Grid Padding="20"
              RowSpacing="12"
              ColumnSpacing="16"
              ColumnDefinitions="Auto,*"
              RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">

            <Image Grid.Row="0" Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Source="settings.png"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            
            <Label Grid.Row="1" Grid.Column="0"
                   Text="{x:Static localization:AppResources.CodeLength}"
                   HorizontalOptions="Start"
                   VerticalOptions="Center" />
            <Entry Grid.Row="1" Grid.Column="1"
                   Keyboard="Numeric"
                   HorizontalOptions="Fill"
                   Text="{Binding CodeLength}" >
                <Entry.Behaviors>
                    <behaviors:NumericEntryBehavior />
                </Entry.Behaviors>
            </Entry>

            <Label Grid.Row="2" Grid.Column="0"
                   Text="{x:Static localization:AppResources.AttemptsCount}"
                   VerticalOptions="Center" />
            <Entry Grid.Row="2" Grid.Column="1"
                   Text="{Binding MaxAttempts}"
                   Keyboard="Numeric"
                   HorizontalOptions="Fill" >
                <Entry.Behaviors>
                    <behaviors:NumericEntryBehavior />
                </Entry.Behaviors>
            </Entry> 

            <Label Grid.Row="3" Grid.Column="0"
                   Text="{x:Static localization:AppResources.Theme}"
                   VerticalOptions="Center" />

            <Picker Grid.Row="3" Grid.Column="1"
                    ItemsSource="{Binding AvailableThemes}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedThemeItem}"
                    HorizontalOptions="Fill" />
            <!--SelectedIndex="{Binding SelectedThemeIndex}"-->
            
            <Label Grid.Row="4" Grid.Column="0"
                   Text="{x:Static localization:AppResources.Language}"
                   VerticalOptions="Center" />
            
            <Picker Grid.Row="4" Grid.Column="1"
                    ItemsSource="{Binding AvailableLanguages}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedLanguageItem}"
                    HorizontalOptions="Fill" />
            <!--SelectedIndex ="{Binding SelectedLanguageIndex}"-->
            
            
            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="{x:Static localization:AppResources.Save}"
                    Command="{Binding SaveSettingsCommand}"
                    HorizontalOptions="Fill" />
            
            <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="{x:Static localization:AppResources.Back}"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Fill" />
        </Grid>
    </Grid>
</ContentPage>