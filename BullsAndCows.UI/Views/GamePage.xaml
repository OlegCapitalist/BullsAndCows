<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.GamePage"
             xmlns:controls="clr-namespace:BullsAndCows.UI.Views.Controls" >

    <Grid>

        <Grid x:Name="PortraitLayout"
              RowDefinitions="Auto, *, Auto"
              ColumnDefinitions="*"
              RowSpacing="8"
              Padding="16,0">

            <controls:GameMenuView Grid.Row="0" />

            <controls:AttemptsHistoryView Grid.Row="1" />

            <controls:GuessInputView Grid.Row="2" />

        </Grid>

        <Grid x:Name="LandscapeLayout" 
            ColumnDefinitions="*, *" 
            RowDefinitions="Auto,*" 
            Padding="16,0" >

            <controls:AttemptsHistoryView Grid.Row="0" Grid.Column="0" />

            <controls:GameMenuView Grid.Row="0" Grid.Column="1" />

            <controls:GuessInputView Grid.Row="1" Grid.Column="1"/>
            
        </Grid>

    </Grid>

</ContentPage>
