<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.RecordsPage" >
    <Shell.TitleView>
        <Grid>
            <Label
                Text="Рекорды"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto,*">
            <Label Grid.Column="0"
               Text="Длина кода:"
               FontAttributes="Bold"
               HorizontalOptions="Start"
               VerticalOptions="Center"
               Margin="10,10"/>
            <Picker Grid.Column="1"
                ItemsSource="{Binding AvailableCodeLengths}"
                SelectedItem="{Binding SelectedCodeLength}"
                HorizontalOptions="Fill" 
                SelectedIndexChanged ="OnCodeLengthChanged"
                Margin="10,10"/>
        </Grid>
        <Grid Grid.Row="1"
              ColumnDefinitions="50,*,100"
              Padding="10,6">

            <Label Grid.Column="0"
                   Text="№"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Grid.Column="1"
                   Text="Попытки"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Grid.Column="2"
                   Text="Дата"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
        </Grid>
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Records}"
                        SelectionMode="None" >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1"
                            Padding="10,6"
                            Margin="0,2"
                            BackgroundColor="{AppThemeBinding Light=White,
                                          Dark=#1E1E1E}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsEven}"
                                         Value="True">
                                 <Setter Property="BackgroundColor"
                                         Value="{AppThemeBinding Light=#F3F0FF,
                                            Dark=#292438}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="50,*,100">
                            <Label Grid.Column="0"
                                   Text="{Binding Number}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding AttemptsCount}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="16" />
                            <Label Grid.Column="2"
                                   Text="{Binding PlayedAt, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="14" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3"
                Text="Очистить рекорды"
                Command="{Binding ClearRecordsCommand}"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Margin="10,10"/>
        <Button Grid.Row="4"
                Text="Назад" 
                Clicked="OnBackClicked"
                HorizontalOptions="Fill" 
                VerticalOptions="Center" 
                Margin="10,10"/>
    </Grid>
</ContentPage>