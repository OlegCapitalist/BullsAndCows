<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BullsAndCows.UI.Views.Controls.AttemptsHistoryView"
             xmlns:localization="clr-namespace:BullsAndCows.UI.Resources.Localization">

    <CollectionView ItemsSource="{Binding Attempts}"
                        VerticalScrollBarVisibility="Default">

        <CollectionView.EmptyView>
            <Label Text="{x:Static localization:AppResources.NoAttempts}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0.6" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                      Padding="8"
                      ColumnSpacing="12">

                    <Label Grid.Column="0"
                           Text="{Binding AttemptNumber}"
                           FontSize="18" />
                    
                    <Label Grid.Column="1"
                           Text="{Binding Guess}"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Grid.Column="2"
                           Text="{Binding Bulls, StringFormat='🐂 {0}'}"
                           FontSize="18" />

                    <Label Grid.Column="3"
                           Text="{Binding Cows, StringFormat='🐄 {0}'}"
                           FontSize="18" />

                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentView>
